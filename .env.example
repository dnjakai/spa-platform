# Copy to .env (or set in your host's environment) and change for production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true

# The platform's domain. Businesses get <slug>.<PLATFORM_DOMAIN>.
# Development: localhost (amani.localhost:8000 resolves to your machine in modern browsers)
# Production example: tenda.co.ke  →  amani.tenda.co.ke
PLATFORM_DOMAIN=localhost
PLATFORM_NAME=Tenda

# Leave as * : the tenant middleware 404s any host that isn't the platform or a known business.
DJANGO_ALLOWED_HOSTS=*
# Production: list origins that post forms, e.g. https://*.tenda.co.ke,https://tenda.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=

# Default is SQLite in the project folder. Production:
# DATABASE_URL=postgres://spa:password@127.0.0.1:5432/spa_platform
DATABASE_URL=

DJANGO_SECURE_COOKIES=false
